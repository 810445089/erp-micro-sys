# ============================================
# 主应用 React18 - 生产环境配置
# ============================================

# 主应用部署路径
#  - 独立域名部署: VITE_BASE=/
#  - 同域路径部署: VITE_BASE=/app/react18/
VITE_BASE=/

# 子应用地址（打包后所有子应用统一放在 release/child/ 下部署）
#  - 同域部署（推荐，默认）: 同源绝对路径，随域名自动适配
#  - 独立域名部署: 改写成完整 URL，例如 https://child.example.com/
VITE_CHILD_REACT18_URL=/child/react18/
VITE_CHILD_NEXTJS_URL=/child/nextjs/
VITE_CHILD_VUE3_URL=/child/vue3/
VITE_CHILD_SIDEBAR_URL=/child/sidebar/
