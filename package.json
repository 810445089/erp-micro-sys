{
  "name": "practise",
  "version": "1.0.0",
  "description": "微服务练手项目",
  "main": "index.js",
  "scripts": {
    "bootstrap": "npm install && npm-run-all --serial i:*",
    "i:react18": "cd apps/react18 && npm install",
    "i:vue3": "cd apps/vue3 && npm install",
    "i:vue": "cd apps/vue && npm install",
    "i:sidebar": "cd childs/sidebar && npm install",
    "i:child-react18": "cd childs/react18 && npm install",
    "i:child-vue3": "cd childs/vue3 && npm install",
    "dev:react18": "npm-run-all --parallel dev-app:react18 dev-child:*",
    "dev:vue3": "npm-run-all --parallel dev-app:vue3 dev-child:*",
    "dev-app:react18": "cd apps/react18 && npm run dev",
    "dev-app:vue3": "cd apps/vue3 && npm run dev",
    "dev-app:vue": "cd apps/vue && npm run dev",
    "dev-child:sidebar": "cd childs/sidebar && npm run dev",
    "dev-child:react18": "cd childs/react18 && npm run dev",
    "dev-child:nextjs16": "cd childs/nextjs16 && npm run dev",
    "dev-child:vue3": "cd childs/vue3 && npm run dev",
    "build:react18": "npm-run-all --parallel build-main:react18 build-child:*",
    "build:app": "npm-run-all --parallel build-app:*",
    "build:child": "npm-run-all --parallel build-child:*",
    "build-main:react18": "cd apps/react18 && npm run build",
    "build-main:nextjs16": "cd apps/nextjs16 && npm run build",
    "build-main:vue3": "cd apps/vue3 && npm run build",
    "build-main:vue": "cd apps/vue && npm run build",
    "build-child:sidebar": "cd childs/sidebar && npm run build",
    "build-child:react18": "cd childs/react18 && npm run build",
    "build-child:nextjs16": "cd childs/nextjs16 && npm run build",
    "build-child:vue3": "cd childs/vue3 && npm run build",
    "preview:react18": "cd apps/react18 && npm run preview",
    "preview:vue3": "cd apps/vue3 && npm run preview",
    "preview:vue": "cd apps/vue && npm run preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "wu",
  "license": "ISC",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@micro-zoe/micro-app": "^1.0.0-rc.32",
    "element-plus": "^2.14.7"
  }
}
